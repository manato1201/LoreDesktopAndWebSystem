# Environment for `docker compose up` at the repo root. Copy this file to
# `.env` (`cp .env.example .env`) before running `docker compose up --build`.
#
# This file is intentionally minimal — it only lists what
# docker-compose.yml itself actually consumes. For the full list of
# variables each component understands (and what each one does), see:
#   lorehub-api/.env.example
#   lorehub-web/.env.example
#
# lorehub-api's container environment is loaded straight from this file
# (see docker-compose.yml's `env_file: .env` on the lorehub-api service), so
# you can also uncomment/add any of lorehub-api's variables (e.g. the
# LOREHUB_SMTP_* ones) directly below.

# Origin lorehub-web is reachable at in your browser — passed to lorehub-api
# for CORS. The default already matches the published port from
# docker-compose.yml's `lorehub-web` service; only change this if you're
# publishing lorehub-web on a different host port.
LOREHUB_WEB_ORIGIN=http://localhost:3000

# Host-reachable address of lorehub-api, baked into lorehub-web's client
# bundle at build time (see lorehub-web/.env.example for why this must stay
# a browser-reachable address, not a Docker-internal service name). The
# default already matches lorehub-api's published port below.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Optional: uncomment to enable outbound email (invites / password reset) ---
# LOREHUB_SMTP_HOST=smtp.example.com
# LOREHUB_SMTP_PORT=587
# LOREHUB_SMTP_USERNAME=
# LOREHUB_SMTP_PASSWORD=
# LOREHUB_SMTP_FROM=LoreHub <no-reply@example.com>

# --- Optional: local-HTTP-dev only, NEVER set true in production ---
# LOREHUB_INSECURE_COOKIES=false
