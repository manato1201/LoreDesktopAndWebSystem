# Environment variables read by lorehub-web. Copy this file to `.env` for
# local `npm run dev`/`npm run build` use.
#
# NOTE for Docker: `docker-compose.yml` at the repo root supplies this as a
# *build* ARG (`build.args.NEXT_PUBLIC_API_URL`), not a container-runtime
# env var — see the comment there for why.

# Base URL lorehub-web's own code (see src/lib/api.ts) uses for every request
# to lorehub-api, both from the browser (`fetch` calls in Client Components)
# and from the Next.js server (Server Components/SSR) — there is no
# server-only/client-only split today, so one value has to work for both.
#
# `NEXT_PUBLIC_*` variables are inlined into the client JS bundle at BUILD
# time (`next build`), not read from the environment when the server starts.
# Changing this value requires rebuilding (`npm run build` / `docker build`),
# not just restarting the running process/container.
#
# Must be an address the BROWSER can resolve and reach, not a
# backend-internal/Docker-internal hostname — this is what actually renders
# in every page the browser loads. Defaults to "http://localhost:4000" if
# unset, matching lorehub-api's default port.
NEXT_PUBLIC_API_URL=http://localhost:4000
