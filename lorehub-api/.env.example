# Environment variables read by lorehub-api at startup (see main.rs,
# email.rs, auth.rs). Copy this file to `.env` and fill in real values —
# `docker-compose.yml` at the repo root loads `lorehub-api`'s container
# environment from `.env` via `env_file`.

# Origin lorehub-web is served from, used for the CORS `Access-Control-Allow-Origin`
# header (see main.rs::build_router). Not required — defaults to
# "http://localhost:3000" (the Next.js dev server) if unset. Must exactly
# match the origin the browser actually loads lorehub-web from, including
# scheme and port.
LOREHUB_WEB_ORIGIN=http://localhost:3000

# Maximum accepted request body size, in bytes (see main.rs's
# RequestBodyLimitLayer). Not required — defaults to 50331648 (48 MiB),
# sized for base64-encoded file uploads (see main.rs's DEFAULT_MAX_BODY_BYTES
# doc comment for why base64 needs headroom over the raw file size).
# LOREHUB_MAX_BODY_BYTES=50331648

# Local-HTTP-dev convenience ONLY. When "true" or "1", session/refresh
# cookies are issued without the `Secure` attribute (see
# auth.rs::cookies_secure) so a browser will still store them over plain
# `http://`. Not required — defaults to secure (`Secure` cookies) when unset,
# which is the correct setting for any deployment served over HTTPS.
#
# NEVER set this to true in production: it strips a real security
# protection (cookies become readable/replayable over plain HTTP), and a
# production deployment should be fronted by real TLS instead (see
# docs/DEPLOYMENT.md) rather than working around cookie security this way.
# LOREHUB_INSECURE_COOKIES=false

# Log output format. "pretty" (default, human-readable — good for a
# developer watching a terminal) or "json" (one JSON object per line —
# needed for a real log aggregator like Loki/CloudWatch to parse fields
# out of each line instead of scraping free-form text; see
# docs/DEPLOYMENT.md's Observability section). Case-insensitive; any
# other value fails fast at startup rather than silently falling back.
# LOREHUB_LOG_FORMAT=pretty

# --- SMTP (outbound email for invite / forgot-password flows) --------------
# All optional as a group — if LOREHUB_SMTP_HOST is unset, lorehub-api logs
# the would-be email at INFO level instead of sending (see
# email.rs::send_email), which is fine for local dev/demo use but means
# invite/reset links only show up in the server logs, not real inboxes.

# SMTP relay hostname. Required to actually send email; leave unset to use
# the log-only fallback described above.
# LOREHUB_SMTP_HOST=smtp.example.com

# SMTP relay port. Optional — defaults to 587 (STARTTLS) if unset.
# LOREHUB_SMTP_PORT=587

# SMTP auth username. Optional — defaults to empty if unset (only correct
# for a relay that doesn't require auth).
# LOREHUB_SMTP_USERNAME=

# SMTP auth password. Optional — defaults to empty if unset. Treat this as a
# secret; do not commit a real value.
# LOREHUB_SMTP_PASSWORD=

# "From" address/display name for outgoing email. Optional — defaults to
# "LoreHub <no-reply@$LOREHUB_SMTP_HOST>" if unset.
# LOREHUB_SMTP_FROM=LoreHub <no-reply@example.com>
